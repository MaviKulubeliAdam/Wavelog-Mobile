rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Callsign ownership registry ──────────────────────────────────────────
    // Each document id = UPPERCASE callsign, value = { uid, claimedAt }
    // Once created it can never be updated or deleted — immutable binding.
    match /callsign_claims/{callsign} {
      allow read: if true;
      // Only the authenticated user can create a claim for themselves,
      // and only if that callsign is not yet taken.
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasAll(['uid', 'claimedAt'])
                    && callsign.matches('[A-Z0-9/]{3,12}')
                    && !exists(/databases/$(database)/documents/callsign_claims/$(callsign));
      allow update, delete: if false;
    }

    // ── Planned activations ───────────────────────────────────────────────────
    match /planned_activations/{docId} {
      allow read: if true;

      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasAll([
                         'uid', 'callsign', 'type', 'scheduledAt', 'expiresAt',
                         'bands', 'modes', 'createdAt', 'subscriberCount', 'notified'
                       ])
                    && request.resource.data.callsign is string
                    && request.resource.data.callsign.size() >= 3
                    && request.resource.data.subscriberCount == 0
                    && request.resource.data.notified == false
                    && get(/databases/$(database)/documents/callsign_claims/$(request.resource.data.callsign)).data.uid == request.auth.uid;

      // a) Subscribe/notify updates: subscriberCount can only change by ±1,
      //    notified can only flip true→false (re-arm) never be set to false
      //    from an already-false state (prevents spam re-notification).
      // b) Full edit: authenticated owner only, callsign & uid unchanged
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['subscriberCount', 'notified'])
                    && (
                         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subscriberCount'])
                          && (request.resource.data.subscriberCount == resource.data.subscriberCount + 1
                              || request.resource.data.subscriberCount == resource.data.subscriberCount - 1)
                          && request.resource.data.subscriberCount >= 0)
                         ||
                         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notified'])
                          && resource.data.notified == true
                          && request.resource.data.notified == false)
                       )
                    || (request.auth != null
                        && request.auth.uid == resource.data.get('uid', '')
                        && request.resource.data.uid == resource.data.uid
                        && request.resource.data.callsign == resource.data.callsign
                        && request.resource.data.keys().hasAll([
                             'callsign', 'type', 'scheduledAt', 'expiresAt',
                             'bands', 'modes'
                           ]));

      // Authenticated owner, OR legacy docs without uid field
      allow delete: if request.auth != null
                    && (!('uid' in resource.data) || resource.data.uid == request.auth.uid);
    }

    // ── Chat rooms ────────────────────────────────────────────────────────────
    match /chat_rooms/{roomId}/messages/{messageId} {
      allow read: if true;

      // Send: authenticated, uid matches auth, callsign verified via claim
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.callsign is string
                    && request.resource.data.callsign.size() >= 3
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 1000
                    && get(/databases/$(database)/documents/callsign_claims/$(request.resource.data.callsign)).data.uid == request.auth.uid;

      // Edit: only the original sender, uid/callsign/timestamp unchanged
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.uid
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.callsign == resource.data.callsign
                    && request.resource.data.timestamp == resource.data.timestamp
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 1000;

      // Delete: only the original sender
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.uid;
    }
  }
}
